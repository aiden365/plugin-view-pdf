<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>com.aiden.plugin.view-pdf</id>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>XCode Tools</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor url="https://www.yourcompany.com">YourCompany</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <description><![CDATA[
        Enter short description for your plugin here.<br>
        <em>most HTML tags may be used</em>
    ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>

    <!-- Extension points defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="com.aiden.plugin.viewpdf.settings.PdfViewerSettings"/>

        <applicationConfigurable
                id="com.aiden.plugin.viewpdf.settings"
                displayName="XCode Tools"
                instance="com.aiden.plugin.viewpdf.settings.PdfViewerConfigurable"/>

        <postStartupActivity implementation="com.aiden.plugin.viewpdf.settings.WordLibraryStartupActivity"/>
        <postStartupActivity implementation="com.aiden.plugin.viewpdf.bookreading.BookReadingStartupActivity"/>

        <notificationGroup id="XTools.BookReading" displayType="TOOL_WINDOW" isLogByDefault="true"/>

        <toolWindow
                id="XTools"
                anchor="bottom"
                factoryClass="com.aiden.plugin.viewpdf.ui.PdfViewerToolWindowFactory"/>

    </extensions>

    <actions>
        <action
                id="com.aiden.plugin.viewpdf.actions.ScrollPdfUp"
                class="com.aiden.plugin.viewpdf.actions.ScrollPdfUpAction"
                text="Scroll PDF Up"
                description="Scroll the XCode Tools up">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt PAGE_UP"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>

        <action
                id="com.aiden.plugin.viewpdf.actions.ScrollPdfDown"
                class="com.aiden.plugin.viewpdf.actions.ScrollPdfDownAction"
                text="Scroll PDF Down"
                description="Scroll the XCode Tools down">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt PAGE_DOWN"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>

        <action
                id="com.aiden.plugin.viewpdf.actions.ClosePdfView"
                class="com.aiden.plugin.viewpdf.actions.ClosePdfViewAction"
                text="Toggle PDF View"
                description="Toggle between PDF view and code disguise">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt END"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>

        <action
                id="com.aiden.plugin.viewpdf.actions.ShowEditorPdfPopup"
                class="com.aiden.plugin.viewpdf.actions.ShowEditorPdfPopupAction"
                text="Show Editor PDF Popup"
                description="Show a floating PDF popup in editor">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>

        <action
                id="com.aiden.plugin.viewpdf.actions.ToggleWordPopup"
                class="com.aiden.plugin.viewpdf.actions.ToggleWordPopupAction"
                text="显示/隐藏单词悬浮框"
                description="显示或隐藏背单词悬浮框">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt W"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>

        <action
                id="com.aiden.plugin.viewpdf.actions.NextWord"
                class="com.aiden.plugin.viewpdf.actions.NextWordAction"
                text="下一个单词"
                description="切换到下一个待学习单词">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>

        <action
                id="com.aiden.plugin.viewpdf.actions.PrevWord"
                class="com.aiden.plugin.viewpdf.actions.PrevWordAction"
                text="上一个单词"
                description="切换到上一个待学习单词">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>

        <action
                id="com.aiden.plugin.viewpdf.actions.MarkWordMastered"
                class="com.aiden.plugin.viewpdf.actions.MarkWordMasteredAction"
                text="切换已学会状态"
                description="切换当前单词为已学会或未学会并持久化">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>

        <action
                id="com.aiden.plugin.viewpdf.actions.PrevBookLine"
                class="com.aiden.plugin.viewpdf.actions.PrevBookLineAction"
                text="上一行"
                description="阅读当前图书上一行并输出到通知栏">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt UP"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>

        <action
                id="com.aiden.plugin.viewpdf.actions.NextBookLine"
                class="com.aiden.plugin.viewpdf.actions.NextBookLineAction"
                text="下一行"
                description="阅读当前图书下一行并输出到通知栏">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt DOWN"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
